---
layout: null
sitemap: false
---
[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"description":{{ post.description | default: post.excerpt | strip_html | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":{{ post.date | date: "%d %B %Y" | jsonify }},"categories":{{ post.categories | join: ", " | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
